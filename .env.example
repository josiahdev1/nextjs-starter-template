# Copy to .env.local and fill in your Supabase credentials. NEVER commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>

# Optional server-only service role key (NEVER prefix with NEXT_PUBLIC_ or expose to client)
# SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
